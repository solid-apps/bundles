{
  "@context": { "schema": "https://schema.org/", "app": "urn:jss:app:" },
  "@id": "#bundle",
  "@type": "schema:ItemList",
  "schema:name": "Productivity",
  "schema:description": "File browser + document editing + workspace + retro shell + team chat + mind mapping + speech-to-text.",
  "schema:itemListElement": [
    { "app:spec": "explorer",                               "app:label": "Explorer",   "app:description": "File explorer — browse / preview / delete with keyboard nav and trash-undo" },
    { "app:spec": "vellum",                                 "app:label": "Vellum",     "app:description": "Markdown editor that saves to your pod" },
    { "app:spec": "hub",                                    "app:label": "Hub",        "app:description": "Multi-app Solid workspace" },
    { "app:spec": "win98",                                  "app:label": "Win98",      "app:description": "Retro-shell desktop with file manager" },
    { "app:spec": "solid-chat/app=chat",                    "app:label": "Chat",       "app:description": "Direct messaging — pair-team communication" },
    { "app:spec": "melvincarvalho/mindstr=mindstr",         "app:label": "Mindstr",    "app:description": "Nostr-native mind mapping — nodes + connections stored as Nostr events" },
    { "app:spec": "melvincarvalho/transcribe=transcribe",   "app:label": "Transcribe", "app:description": "Real-time speech to text — runs entirely in your browser" }
  ]
}
