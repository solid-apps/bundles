    { "app:spec": "forum",                               "app:label": "Forum",   "app:description": "Discord-style forum — agent-mediated discussion and record of work" },
    { "app:spec": "chrome",                              "app:label": "Chrome",  "app:description": "Window manager and app shelf — one window per agent's view" }
