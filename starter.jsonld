  "schema:name": "Starter",
  "schema:description": "Minimal pleasant first-run set: a window manager, a markdown editor, a PDF reader, an alarm clock, direct messaging.",
  "schema:itemListElement": [
    { "app:spec": "chrome",              "app:label": "Chrome", "app:description": "Window manager and app shelf" },
